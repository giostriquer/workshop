#!/usr/bin/env node
const fs = require('node:fs');
const file = process.env.CI_WATCHER_FIXTURE;
if (!file) { process.stderr.write('Missing isolated fixture'); process.exit(97); }
if (process.env.CI_WATCHER_TRACE) {
  const lock = `${process.env.CI_WATCHER_STATE}.lock`;
  fs.appendFileSync(process.env.CI_WATCHER_TRACE, JSON.stringify({ args: process.argv.slice(2),
    watcherPid: process.ppid, lockOwner: fs.existsSync(lock) ? fs.readFileSync(lock, 'utf8') : null }) + '\n');
}
const rows = JSON.parse(fs.readFileSync(file, 'utf8'));
const row = rows.shift();
if (!row || JSON.stringify(row.args) !== JSON.stringify(process.argv.slice(2))) {
  process.stderr.write('Unexpected GitHub command: ' + JSON.stringify(process.argv.slice(2)));
  process.exit(97);
}
fs.writeFileSync(file, JSON.stringify(rows));
setTimeout(() => process.stdout.write(JSON.stringify(row.response)), row.delayMs || 0);
