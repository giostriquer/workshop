{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "findings",
    "limitations"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "CLEAR",
        "FINDINGS",
        "INSUFFICIENT_CONTEXT"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "concern",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "concern": {
            "type": "string",
            "enum": [
              "scope_drift",
              "missing_outcome",
              "unproven_prerequisite",
              "claim_gap"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
