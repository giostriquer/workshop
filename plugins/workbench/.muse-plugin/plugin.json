{
  "schemaVersion": 1,
  "name": "workbench",
  "displayName": "Workbench",
  "version": "0.59.1",
  "description": "A complete process system for how work starts, gets designed, gets verified, and lands: audits scoped from the request, brainstorming that resolves design and route choices (direct / plan), shared codebase-design and domain-modeling guidance before workset decomposition, implementation discipline (TDD, systematic debugging, evidence-gated readiness), a comment trim and adversarial review at readiness, and landing that files the PR and tends CI to green. Backed by five read-only review agents and a comment-trimming agent. Core process skills derived from obra/superpowers (MIT): no hooks, no dispatcher; skills fire on relevance. Adds epic-orchestration for multi-ticket epics whose lanes other sessions implement and the operator dispatches by hand.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
